# Copy this file to config.toml and customize it for your machine.
# config.toml is intentionally gitignored because environments and service
# endpoints can differ between systems.

[defaults]
user_agent = "api-test/1.0"

[environments.test]
base_url = "https://httpbin.org"

[environments.test.values]
resource = "users"

[environments.local]
base_url = "http://localhost:8080"
